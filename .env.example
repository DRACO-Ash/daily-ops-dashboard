# Application
APP_ENV=development
APP_SECRET_KEY=changeme-use-a-long-random-string-minimum-32-characters
APP_ALLOWED_ORIGINS=["https://localhost"]

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ops_dashboard
POSTGRES_USER=ops_user
POSTGRES_PASSWORD=changeme

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Mattermost
MATTERMOST_URL=https://your-mattermost-instance.com
# Personal access token of the bot account (dok.bot). Asks search only
# channels the bot is a member of.
MATTERMOST_BOT_TOKEN=changeme
# Team URL name that asks and full-history pulls work in.
MATTERMOST_TEAM=jco
# Optional: the team id, to skip the name lookup.
MATTERMOST_TEAM_ID=
# Nothing is pulled continuously. Every interval, the app runs asks and
# full-history pulls that an operator has made due.
MATTERMOST_INTERVAL_SECONDS=60
# Full-history pulls: 200-post pages per channel per cycle.
MATTERMOST_BACKFILL_PAGES_PER_CYCLE=10
# Search or history pages one ask run may read before it stops "partial".
MATTERMOST_ASK_MAX_PAGES=20
MATTERMOST_PROMPT_WINDOW_HOURS=6
MATTERMOST_MAX_MESSAGES_IN_PROMPT=30

# UDL
UDL_BASE_URL=https://unifieddatalibrary.com/udl
UDL_USERNAME=
UDL_PASSWORD=
UDL_REQUEST_TIMEOUT_SECONDS=30
UDL_VERIFY_SSL=true

# AI
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# Storage
PROCEDURE_STORAGE_PATH=/data/procedures

# Background refresh
BACKGROUND_REFRESH_ENABLED=true
BACKGROUND_AUTO_EVALUATE=true
BACKGROUND_MAX_EVALUATIONS_PER_CYCLE=20
BACKGROUND_MAX_EVENT_SUMMARIES_PER_CYCLE=20

# Per-surface refresh cadences and windows
BACKGROUND_NOTIFICATION_INTERVAL_SECONDS=3600
BACKGROUND_NOTIFICATION_WINDOW_HOURS=120
BACKGROUND_MANEUVER_INTERVAL_SECONDS=600
BACKGROUND_MANEUVER_WINDOW_HOURS=48