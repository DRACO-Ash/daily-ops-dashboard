# Application
APP_ENV=development
APP_SECRET_KEY=changeme-use-a-long-random-string-minimum-32-characters
APP_ALLOWED_ORIGINS=["https://localhost"]

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ops_dashboard
POSTGRES_USER=ops_user
POSTGRES_PASSWORD=changeme

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Mattermost
MATTERMOST_URL=https://your-mattermost-instance.com
MATTERMOST_BOT_TOKEN=changeme
MATTERMOST_TEAM_ID=your_team_id_here
MATTERMOST_POLL_INTERVAL=60
# Comma-separated channel IDs to ingest. Get the ID from a channel's
# Mattermost URL (the last path segment) or via the REST API. The bot
# account must be a member of each channel.
MATTERMOST_CHANNEL_IDS=
MATTERMOST_INTERVAL_SECONDS=60
MATTERMOST_PROMPT_WINDOW_HOURS=6
MATTERMOST_MAX_MESSAGES_IN_PROMPT=30

# UDL
UDL_BASE_URL=https://unifieddatalibrary.com/udl
UDL_USERNAME=
UDL_PASSWORD=
UDL_REQUEST_TIMEOUT_SECONDS=30
UDL_VERIFY_SSL=true

# AI
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# Storage
PROCEDURE_STORAGE_PATH=/data/procedures

# Background refresh
BACKGROUND_REFRESH_ENABLED=true
BACKGROUND_AUTO_EVALUATE=true
BACKGROUND_MAX_EVALUATIONS_PER_CYCLE=20
BACKGROUND_MAX_EVENT_SUMMARIES_PER_CYCLE=20

# Per-surface refresh cadences and windows
BACKGROUND_NOTIFICATION_INTERVAL_SECONDS=3600
BACKGROUND_NOTIFICATION_WINDOW_HOURS=120
BACKGROUND_MANEUVER_INTERVAL_SECONDS=600
BACKGROUND_MANEUVER_WINDOW_HOURS=48